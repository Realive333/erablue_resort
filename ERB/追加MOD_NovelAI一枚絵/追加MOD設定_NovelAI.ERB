;------------------------------------------------
;追加MODとして機能を本体に繋げるための関数群
;------------------------------------------------
;関数名を特定の条件に沿って付けることで、erablue_resort本体から機能を呼び出す事ができる。

;------------------------------------------------
;サイド領域に関する追加MOD関数
;------------------------------------------------
@追加MOD_サイド領域項目表示_NovelAI(表示位置, 横幅, 縦位置, 表示文字列)
#DIM REF 表示位置
#DIM REF 横幅
#DIM 縦位置
#DIMS REF 表示文字列
;サイド領域の項目を増やす関数

表示位置 += 横幅 + 50
横幅 = 450
IF NAI_有効()
	表示文字列 += @"<div rect='{表示位置}, {縦位置 - 15}, {横幅}, 200' padding='25,15,0' color='#101010' border='31' bcolor='#C0C0C0'><font color='#%カラーパレット_HTML("黄")%'><button value='サイド領域_サイド切り替え_NovelAI'>NovelAI</button></font></div>"
ELSE
	表示文字列 += @"<div rect='{表示位置}, {縦位置 - 15}, {横幅}, 200' padding='25,15,0' color='#101010' border='31' bcolor='#C0C0C0'><font color='#%カラーパレット_HTML("グレーアウト")%'><button value='サイド領域_サイド切り替え_NovelAI'>NovelAI</button></font></div>"
ENDIF
SIF サイド描画表示種類 == "NovelAI"
	表示文字列 += @"<div rect='{表示位置 + 25}, {縦位置 - 35}, {横幅 - 40}, 60' color='#101010'></div>"



@追加MOD_サイド領域実行_サイド領域_NovelAI設定()
;サイド領域の処理実行関数

CALL OPTION_NOVELAI
RETURN 1

@追加MOD_サイド領域実行_サイド領域_NovelAI再生成()
;サイド領域の処理実行関数

CALL NAI_再生成
RETURN 1

@サイド描画表示種類_NovelAI(表示文字列, 追加表示文字列)
#DIMS REF 表示文字列
#DIMS REF 追加表示文字列
#DIM 画像幅
#DIMS 生成状態
;サイド領域の表示関数

CALL NAI_画像取得
IF !RESULT
	RETURN 0
ENDIF

IF RESULTS != ""
	;何番でもいいけどとりあえず19990を使用
	GDISPOSE 19990
	SPRITEDISPOSE "NovelAI"
	CALL GCREATE_拡張子(19990, RESULTS)
	IF RESULT
		SPRITECREATE "NovelAI", 19990
		画像幅 = MIN(4000, 3650 * GWIDTH(19990) / GHEIGHT(19990), GWIDTH(19990) * 100 / GETCONFIG("フォントサイズ"))
		表示文字列 += @"<img src='NovelAI' width='{画像幅}' height='{画像幅 * GHEIGHT(19990) / GWIDTH(19990)}'>"
	ENDIF
ENDIF
; 親divを閉じた後に合成される追加領域へ出す（Emueraはdivの入れ子不可）。
追加表示文字列 += "<div rect='5625,3820,4100,450'><button value='サイド領域_NovelAI設定'>[NovelAI設定]</button> <button value='サイド領域_サイド切り替え_NovelAI'>[画像更新]</button>"
IF NAI_有効()
	追加表示文字列 += " <button value='サイド領域_NovelAI再生成'>[再生成]</button>"
	生成状態 '= LOADTEXT("novelai/runtime/status.txt", 0, 1)
	生成状態 '= REPLACE(REPLACE(REPLACE(生成状態, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
	追加表示文字列 += @"<br>%生成状態%"
ENDIF
追加表示文字列 += "</div>"



;------------------------------------------------
;OPTIONに関する追加MOD関数
;------------------------------------------------

@追加MOD_OPTION項目_NovelAI自動一枚絵の設定()
CALL OPTION_NOVELAI

